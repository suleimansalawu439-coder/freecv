# ==============================================================================
# Cvyon Environment Variables Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Next.js App Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ------------------------------------------------------------------------------
# 2. Supabase Configuration (Database & Auth)
# ------------------------------------------------------------------------------
# Get these from Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR_PROJECT_ID].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# IMPORTANT: Required for server-side admin actions to bypass RLS policies. 
# Do NOT prefix with NEXT_PUBLIC_ to keep it out of the browser bundle.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret"

# ------------------------------------------------------------------------------
# 3. Google Gemini (AI Integration)
# ------------------------------------------------------------------------------
# Required for AI-assisted resume generation and ATS scoring
GEMINI_API_KEY="your-gemini-api-key"

# ------------------------------------------------------------------------------
# 4. Paystack (Payments & Billing)
# ------------------------------------------------------------------------------
# Public key for frontend checkout initialization
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_..."

# Secret key for backend API calls and webhook signature verification
PAYSTACK_SECRET_KEY="sk_test_..."

# ------------------------------------------------------------------------------
# 5. Brevo (Transactional Emails)
# ------------------------------------------------------------------------------
# Required for sending invoices and talent pool CSV exports
BREVO_API_KEY="xkeysib-..."
BREVO_SENDER_EMAIL="noreply@cvyon.com"

# ------------------------------------------------------------------------------
# 6. Upstash (Rate Limiting & Webhook Queues)
# ------------------------------------------------------------------------------
# Required for API route rate limiting
UPSTASH_REDIS_REST_URL="https://..."
UPSTASH_REDIS_REST_TOKEN="..."

# Optional: For async webhook processing
QSTASH_URL="https://qstash.upstash.io"
QSTASH_TOKEN="..."

# ------------------------------------------------------------------------------
# 7. CareerJet Affiliate Integration
# ------------------------------------------------------------------------------
# The affiliate API key
CAREERJET_API_KEY="your-careerjet-affiliate-key"

# The Namecheap proxy URL for fixed-IP requests
CAREERJET_PROXY_URL="https://proxy.ojnfoundation.org/careerjet.php"

# Shared secret for authenticating with the PHP proxy
CAREERJET_PROXY_SECRET="CVYON_SECURE_PROXY_2026"

# ------------------------------------------------------------------------------
# 8. Admin & Security
# ------------------------------------------------------------------------------
# Static password for /admin dashboard access
ADMIN_PASSWORD="super-secret-admin-password"

# Secret token for protecting cron endpoints
CRON_SECRET="your-cron-secret-token"

# Comma-separated list of recruiter emails to receive the weekly talent pool CSV
RECRUITER_EMAILS="test@cvyon.com"
